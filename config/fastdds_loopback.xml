<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS profile that forces all RTPS traffic onto loopback (127.0.0.1).
  Used when RMW_IMPLEMENTATION is rmw_fastrtps_cpp (the ROS 2 default on
  Humble/Jazzy). See the rationale in cyclonedds_loopback.xml: under
  --net=host an uncontained transport leaks discovery and topics onto the LAN.

  Selected via FASTRTPS_DEFAULT_PROFILES_FILE (see scripts/run.bash /
  setup.env RR_FASTRTPS_PROFILE). Bind-mounted into the container at
  /ros2_ws/config.
-->
<profiles xmlns="http://www.eprosima.com">

  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_loopback</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="loopback_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_loopback</transport_id>
      </userTransports>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4><address>127.0.0.1</address></udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
