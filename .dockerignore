# The Dockerfile does not COPY ros2_ws, it is bind-mounted at runtime. Keep
# these out of the build context so docker build doesn't ship colcon artifacts
# over to the daemon on every build.
ros2_ws/build
ros2_ws/install
ros2_ws/log

# VCS / editor / OS noise.
.git
.gitignore
.gitmodules
.github
.vscode
.idea
**/.DS_Store

# Generated devcontainer file (the committed template is still copied in
# because the Dockerfile never references it, but the rendered output is
# per-user and should not end up in an image).
.devcontainer/devcontainer.json

# Docs and images aren't needed at build time.
doc
img
README.md
